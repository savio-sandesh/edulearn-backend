{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/gateway/auth/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/auth/{**remainder}"
          }
        ]
      },
      "course-route": {
        "ClusterId": "course-cluster",
        "Match": {
          "Path": "/gateway/course/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/courses/{**remainder}"
          }
        ]
      },
      "content-route": {
        "ClusterId": "content-cluster",
        "Match": {
          "Path": "/gateway/content/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/lessons/{**remainder}"
          }
        ]
      },
      "enrollment-route": {
        "ClusterId": "enrollment-cluster",
        "Match": {
          "Path": "/gateway/enrollment/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/enrollments/{**remainder}"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5144/"
          }
        }
      },
      "course-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5224/"
          }
        }
      },
      "content-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5176/"
          }
        }
      },
      "enrollment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5259/"
          }
        }
      }
    }
  },
  "Jwt": {
    "Key": "MzlhZDI0M2EtNzdiNi00YjVjLWFmZTMtYmU5M2U2ZGZlM2I4Cg==",
    "Issuer": "EduLearnAuth",
    "Audience": "EduLearnUsers"
  }
}