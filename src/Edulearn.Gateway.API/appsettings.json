{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/gateway/auth/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**remainder}"
          }
        ]
      },
      "assessment-route": {
        "ClusterId": "assessment-cluster",
        "Match": {
          "Path": "/gateway/assessment/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/quizzes/{**remainder}"
          }
        ]
      },
      "review-submission-shortcut": {
        "ClusterId": "review-cluster",
        "Match": {
          "Path": "/gateway/course/reviews/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/reviews/{**remainder}"
          }
        ]
      },
      "course-route": {
        "ClusterId": "course-cluster",
        "Match": {
          "Path": "/gateway/course/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/courses/{**remainder}"
          }
        ]
      },
      "content-route": {
        "ClusterId": "content-cluster",
        "Match": {
          "Path": "/gateway/content/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/lessons/{**remainder}"
          }
        ]
      },
      "enrollment-route": {
        "ClusterId": "enrollment-cluster",
        "Match": {
          "Path": "/gateway/enrollment/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/enrollments/{**remainder}"
          }
        ]
      },
      "progress-route": {
        "ClusterId": "progress-cluster",
        "Match": {
          "Path": "/gateway/progress/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/progress/{**remainder}"
          }
        ]
      },
      "review-route": {
        "ClusterId": "review-cluster",
        "Match": {
          "Path": "/gateway/review/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/reviews/{**remainder}"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://localhost:5206/"
          }
        }
      },
      "assessment-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://localhost:5012/"
          }
        }
      },
      "course-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://localhost:5224/"
          }
        }
      },
      "content-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://localhost:5176/"
          }
        }
      },
      "enrollment-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://localhost:5259/"
          }
        }
      },
      "progress-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://localhost:5218/"
          }
        }
      },
      "review-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://localhost:5144/"
          }
        }
      }
    }
  },
  "Jwt": {
    "Key": "MzlhZDI0M2EtNzdiNi00YjVjLWFmZTMtYmU5M2U2ZGZlM2I4Cg==",
