{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/gateway/auth/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/gateway/auth" },
          { "PathPrefix": "/api/auth" }
        ]
      },
      "assessment-route": {
        "ClusterId": "assessment-cluster",
        "Match": {
          "Path": "/gateway/assessment/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/gateway/assessment" },
          { "PathPrefix": "/api/quizzes" }
        ]
      },
      "review-submission-shortcut": {
        "ClusterId": "review-cluster",
        "Match": {
          "Path": "/gateway/course/reviews/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/gateway/course/reviews" },
          { "PathPrefix": "/api/reviews" }
        ]
      },
      "course-route": {
        "ClusterId": "course-cluster",
        "Match": {
          "Path": "/gateway/course/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/gateway/course" },
          { "PathPrefix": "/api/courses" }
        ]
      },
      "content-route": {
        "ClusterId": "content-cluster",
        "Match": {
          "Path": "/gateway/content/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/gateway/content" },
          { "PathPrefix": "/api/lessons" }
        ]
      },
      "enrollment-route": {
        "ClusterId": "enrollment-cluster",
        "Match": {
          "Path": "/gateway/enrollment/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/gateway/enrollment" },
          { "PathPrefix": "/api/enrollments" }
        ]
      },
      "progress-route": {
        "ClusterId": "progress-cluster",
        "Match": {
          "Path": "/gateway/progress/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/gateway/progress" },
          { "PathPrefix": "/api/progress" }
        ]
      },
      "review-route": {
        "ClusterId": "review-cluster",
        "Match": {
          "Path": "/gateway/review/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/gateway/review" },
          { "PathPrefix": "/api/reviews" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://auth-api/"
          }
        }
      },
      "assessment-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://assessment-api/"
          }
        }
      },
      "course-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://course-api/"
          }
        }
      },
      "content-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://content-api/"
          }
        }
      },
      "enrollment-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://enrollment-api/"
          }
        }
      },
      "progress-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://progress-api/"
          }
        }
      },
      "review-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://review-api/"
          }
        }
      }
    }
  }
}