{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Key": "<set-via-user-secrets-or-environment-variable>",
    "Issuer": "EduLearnAuthAPI",
    "Audience": "EduLearnAngularClient",
    "DurationInMinutes": 1440,
    "RefreshTokenDurationInDays": 7
  },
  "ConnectionStrings": {
    "DefaultConnection": "<set-via-user-secrets-or-environment-variable>"
  },
  "AzureStorage": {
    "ConnectionString": "<set-via-user-secrets-or-environment-variable>",
    "ContainerName": "avatars",
    "SasExpiryMinutes": 30
  },
  "AllowedHosts": "*"
}